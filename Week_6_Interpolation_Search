
// Interpolation search (without recursion)
#include <stdio.h>
int main(){
    int n, low, high, pos, x;
    printf("Enter size of array: ");
    scanf("%d", &n);
    int a[n];
    printf("Enter array elements:\n");
    for(int i = 0; i < n; i++){
        scanf("%d", &a[i]);
    }
    printf("Enter element you wish to search for: ");
    scanf("%d", &x);
    low = 0; high = n - 1;
    while(low < high){
        pos = low + (((x - a[low])/(a[high] - a[low])) * (high - low));
        if(x == a[pos]){
            printf("%d at %d index", x, pos);
            return 1;
        } else if (x < a[pos]){
            high = pos - 1;
        } else{
            low = pos + 1;
        }
    }
    printf("%d not in array", x);
}


// Interpolation search (with recursion)
#include <stdio.h>
int interpolation(int a[], int n, int x, int low, int high){
    if(low > high){
        return -1;
    }
    int pos = low + (((x - a[low])/(a[high] - a[low])) * (high - low));
    if(x == a[pos]){
        return pos;
    } else if (x < a[pos]){
        return interpolation(a, n, x, low, pos - 1);
    } else{
        return interpolation(a, n, x, pos + 1, high);
    }
}
int main(){
    int n, low, high, pos, x;
    printf("Enter array size: ");
    scanf("%d", &n);
    int a[n];
    printf("Enter elements of an array: ");
    for(int i = 0; i < n; i++){
        scanf("%d", &a[i]);
    }
    printf("Enter element you wish to search for: ");
    scanf("%d", &x);
    int res = interpolation(a, n, x, 0, n - 1);
    (res == -1)?(printf("%d not in array", x)):printf("%d at %d index", x, res);
}
