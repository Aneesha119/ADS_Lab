
//minmax stack

#include <stdio.h>

int top = -1, stck[10], min[10], max[10];

void push(int x){
    if(top == 9){
        printf("Stack overflow");
        return;
    }
    stck[++top] = x;
    if(top == 0){
        max[top] = x;
        min[top] = x;
    } else if(x > max[top - 1]){
        max[top] = x;
        min[top] = min[top - 1];
    } else if(x < min[top - 1]){
        min[top] = x;
        max[top] = max[top - 1];
    } else{
        max[top] = max[top - 1];
        min[top] = min[top - 1];
    }
}

void pop(){
    if(top == -1){
        printf("Stack underflow");
        return;
    }
    printf("popped element: %d", stck[top--]);
}

void display(){
    for(int i = 0; i <= top; i++){
        printf("main: %d  min: %d  max: %d\n", stck[i], min[i], max[i]);
    }
}

int main(){
    int choice, c = 1, elem;
    while(c){
        printf("Operations offered:\n1. push\n2. pop\n3. display\nenter choice: ");
        scanf("%d", &choice);
        switch(choice){
            case 1:
                printf("Enter element: ");
                scanf("%d", &elem);
                push(elem);
                break; 
            case 2:
                pop();
                break;
            case 3:
                display();
                break;
            default:
                printf("Wrong choice!");
                break;
        }
        printf("enter 1 if you wish to continue, else, enter 0: ");
        scanf("%d", &c);
    }
}

