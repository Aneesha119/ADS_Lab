//array
#include <stdio.h>
int a[20], n, pos;
void insert(int m){
    n++;
    if(pos != n){
        for(int i = n; i >= pos - 1; i--){
            a[i + 1] =a[i];
        }
        a[pos-1] = m;
    }
}
void del(){
    for(int i = pos-1; i < n; i++){
        a[i] = a[i+1];
    }
    n--;
}
int search(int m){
    for(int i = 0; i < n; i++){
        if(a[i] == m){
            return i;
        }
    }
    return -1;
}
void disp(){
    for(int i = 0; i < n; i++){
        printf("idx %d: %d\n", i+1, a[i]);
    }
}
int main(){
    int ch, c, el;
    printf("enter size of array: ");
    scanf("%d", &n);
    printf("enter elements of array:\n");
    for(int i = 0; i < n; i++){
        scanf("%d", &a[i]);
    }
    while(c){
        printf("operations offered:\n1. Insert\n2. Delete\n3. Search\n4. Display\n");
        printf("enter choice: ");
        scanf("%d", &ch);
        switch(ch){
            case 1:
                printf("element to be inserted: ");
                scanf("%d", &el);
                printf("position to be inserted: ");
                scanf("%d", &pos);
                insert(el);
                break;
            case 2:
                printf("position to be deleted: ");
                scanf("%d", &pos);
                del();
                break;
            case 3:
                printf("item to be searched: ");
                scanf("%d", &el);
                int idx = search(el);
                (idx >= 0)?printf("%d at %d position\n", el, idx + 1):printf("%d not in array\n", el);
                break;
            case 4:
                disp();
                break;
            default:
                printf("choice out of bounds");
                break;
        }
        printf("if you wish to continue, enter 1 else enter 0: ");
        scanf("%d", &c);
    }
}
