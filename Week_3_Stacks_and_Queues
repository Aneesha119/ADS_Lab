    }
}


//queue dynamic
#include <stdio.h>
#include <stdlib.h>

struct Node{
    int data;
    struct Node* link;
};

struct Node *front = NULL, *rear = NULL, *temp;

void enqueue(int x){
    temp = (struct Node*) malloc (sizeof(struct Node));
    temp -> data = x;
    temp -> link = NULL;
    if(front == NULL && rear == NULL){
        front = temp;
        rear = temp;
        return;
    }
    rear -> link = temp;
    rear = temp;
}

void dequeue(){
    if(front == NULL && rear == NULL){
        printf("queue underflow");
        return;
    }
    temp = front;
    printf("dequeued element: %d", front -> data);
    front = front -> link;
    free(temp);
}

void disp(){
    temp = front;
    while(temp != NULL){
        printf("data: %d\t", temp -> data);
        temp = temp -> link;
    }
}

